#!/usr/bin/env bash
# autocommit-agent — autocommit의 기본 커밋 실행기. autocommit의 run_hoc가 `<실행기> -c <지시>`로 부른다.
#
#   AC_AGENT=<claude|codex|opencode|agy> autocommit-agent -c ["추가지시"]
#
# 현재 폴더(워크트리)의 변경을 지정한 코딩 CLI에게 headless로 커밋시킨다. 각 CLI의 권한 설정으로
# git 조회·add·commit만 허용하고 push·reset·브랜치 변경·파일 수정은 막는다. 커밋 작성자는 저장소의 git 설정을 따른다.
# 사후 검증(HEAD·브랜치·직선 이력)은 autocommit이 한다. 이 스크립트는 종료 코드만 돌려준다.
#   AC_AGENT_MODEL   선택. 각 CLI의 모델 이름
#   HOC_TIMEOUT      완료 대기 ms (기본 900000). 초과하면 종료하고 실패로 돌려준다
set -uo pipefail

[ "${1:-}" = -c ] || { sed -n '3,4p' "$0" | sed 's/^# \?//' >&2; exit 2; }
EXTRA=${2:-}
AGENT=${AC_AGENT:-}
MODEL=${AC_AGENT_MODEL:-}
TIMEOUT=${HOC_TIMEOUT:-900000}
[[ "$TIMEOUT" =~ ^[1-9][0-9]*$ ]] || { echo "autocommit-agent: HOC_TIMEOUT은 양의 정수(ms)" >&2; exit 2; }
case "$AGENT" in
  claude|codex|opencode|agy) ;;
  '') echo "autocommit-agent: AC_AGENT를 지정해야 한다 (claude|codex|opencode|agy)" >&2; exit 2 ;;
  *) echo "autocommit-agent: 지원하지 않는 AC_AGENT: $AGENT" >&2; exit 2 ;;
esac
command -v "$AGENT" >/dev/null || { echo "autocommit-agent: $AGENT 실행 파일이 없다" >&2; exit 2; }
command -v timeout >/dev/null || { echo "autocommit-agent: timeout 필요" >&2; exit 2; }
# opencode·agy 권한 설정은 jq로 만든다. jq가 없으면 빈 설정으로 제한 없이 돌게 되므로 먼저 막는다
case "$AGENT" in opencode|agy) command -v jq >/dev/null || { echo "autocommit-agent: $AGENT에는 jq 필요" >&2; exit 2; } ;; esac
git rev-parse --git-dir >/dev/null 2>&1 || { echo "autocommit-agent: Git 저장소 안에서 실행해야 한다" >&2; exit 2; }

BRIEF="이 저장소($PWD)에서 지금 워킹트리의 변경을 커밋해라.
- 먼저 \`git log --oneline -10\`으로 기존 커밋 스타일을 확인한다.
- 변경을 논리 단위로 쪼개 atomic하게, Conventional Commits 형식으로 커밋한다.
- 저장소의 AGENTS.md·CLAUDE.md 같은 규칙 파일이 있으면 읽고 따른다.
- 한 번의 셸 호출에 git 명령 하나만 쓴다. git -C, git -c, cd, 파이프, 명령 구분자, 리다이렉션을 쓰지 않는다.
- 파일을 수정하지 않는다. \`git add -A\`·디렉터리 통째 스테이징 금지 — \`git add -- <파일>\`로 파일을 명시한다.
- push·reset·rebase·merge·amend·브랜치 생성/전환 금지. 테스트·빌드 실행 금지.
- \`Co-authored-by\`/\`Signed-off-by\` 등 AI·도구 트레일러 금지.
- 끝나면 만든 커밋의 SHA와 제목만 한 줄씩 출력한다."
[ -n "$EXTRA" ] && BRIEF="$BRIEF
추가 지시: $EXTRA"

# 허용·금지 git 명령. CLI마다 표기만 다르다.
ALLOW_GIT=('git status' 'git diff' 'git log' 'git show' 'git ls-files' 'git check-ignore'
           'git rev-parse' 'git branch --show-current' 'git add --' 'git commit')
DENY_GIT=('git push' 'git reset' 'git clean' 'git checkout' 'git switch' 'git restore'
          'git rebase' 'git merge' 'git stash' 'git commit --amend' 'git -C' 'git -c')

json_list() { printf '%s\n' "$@" | jq -R . | jq -cs .; }

case "$AGENT" in
  claude)
    # --bare는 API 키 인증만 받아 구독 사용자를 막으므로 쓰지 않는다. dontAsk는 허용 목록 밖을 거절한다.
    allow=(Read Glob Grep) deny=()
    for c in "${ALLOW_GIT[@]}"; do allow+=("Bash($c *)"); done
    allow+=('Bash(git branch --show-current)')
    for c in "${DENY_GIT[@]}"; do deny+=("Bash($c *)"); done
    CMD=(claude -p --no-session-persistence --strict-mcp-config --mcp-config '{"mcpServers":{}}'
         --tools 'Bash,Read,Glob,Grep' --permission-mode dontAsk
         --allowedTools "${allow[@]}" --disallowedTools "${deny[@]}"
         ${MODEL:+--model "$MODEL"} -- "$BRIEF")
    ;;
  codex)
    # codex sandbox는 .git을 항상 읽기 전용으로 두어 커밋할 수 없고, 명령 단위 허용 목록도 없다.
    # 그래서 제한 없는 실행만 가능하다 — push 금지는 지시문뿐이므로 명시적으로 동의한 경우에만 돈다.
    [ "${AC_AGENT_UNRESTRICTED:-0}" = 1 ] || {
      echo "autocommit-agent: codex는 권한 제한 없이 실행된다(push도 막지 못함). 감수하려면 AC_AGENT_UNRESTRICTED=1" >&2; exit 2; }
    CMD=(codex exec --sandbox danger-full-access -c approval_policy='"never"' --ephemeral --color never
         ${MODEL:+--model "$MODEL"} -C "$PWD" -- "$BRIEF")
    ;;
  opencode)
    # 저장소의 opencode 설정이 권한을 넓히지 못하게 끄고, 이번 실행 설정만 주입한다. 마지막에 맞는 규칙이 이긴다.
    perms=$(jq -cn '[{action:"*",resource:"*",effect:"deny"},
                     {action:"read",resource:"*",effect:"allow"},
                     {action:"glob",resource:"*",effect:"allow"},
                     {action:"grep",resource:"*",effect:"allow"}]')
    for c in "${ALLOW_GIT[@]}"; do perms=$(jq -c --arg r "$c *" '. + [{action:"shell",resource:$r,effect:"allow"}]' <<<"$perms"); done
    for c in "${DENY_GIT[@]}"; do perms=$(jq -c --arg r "$c *" '. + [{action:"shell",resource:$r,effect:"deny"}]' <<<"$perms"); done
    export OPENCODE_CONFIG_PROJECT_DISABLE=1
    OPENCODE_CONFIG_CONTENT=$(jq -cn --argjson p "$perms" '{permissions:$p}')
    export OPENCODE_CONFIG_CONTENT
    # 백그라운드 서비스는 자기 설정으로 돌아 주입 설정을 무시할 수 있으므로 전용 서버로 실행한다.
    CMD=(opencode run --standalone --archived ${MODEL:+--model "$MODEL"} -- "$BRIEF")
    ;;
  agy)
    # 우선순위 Deny > Ask > Allow. 프로젝트 안 쓰기는 기본 허용이라 write_file(*)을 명시적으로 막는다.
    allow=() deny=('write_file(*)')
    for c in "${ALLOW_GIT[@]}"; do allow+=("command($c)"); done
    for c in "${DENY_GIT[@]}"; do deny+=("command($c)"); done
    settings=$(jq -cn --argjson a "$(json_list "${allow[@]}")" --argjson d "$(json_list "${deny[@]}")" \
      '{permissions:{allow:$a,deny:$d,ask:[]}}')
    CMD=(agy --disable-slash-commands --settings "$settings" ${MODEL:+--model "$MODEL"} -p "$BRIEF")
    ;;
esac

printf -v SECS '%d.%03d' "$((TIMEOUT / 1000))" "$((TIMEOUT % 1000))"
echo "autocommit-agent: agent=$AGENT cwd=$PWD" >&2
timeout --kill-after=5s "${SECS}s" "${CMD[@]}" </dev/null
rc=$?
[ "$rc" = 124 ] && echo "autocommit-agent: ${SECS}s 초과로 중단" >&2
git log --oneline -5 2>/dev/null || true
git status --short 2>/dev/null || true
exit "$rc"
