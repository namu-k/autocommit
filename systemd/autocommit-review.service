[Unit]
Description=autocommit weekly review of markers that do not clear themselves

[Service]
Type=oneshot
# systemd 기본 PATH에는 사용자 설치 CLI가 없다. codex 등이 다른 곳에 있으면 `systemctl --user edit autocommit-review.service`로
# Environment=PATH=... 를 덮어쓴다. 같은 방법으로 loop와 같은 Environment=AC_REMOTE_ALLOW=<정규식> 을 넣어야 tidy가
# 원격에 이미 올라간 브랜치의 push 금지 마커를 풀 수 있고, 메일 보고는 Environment=AC_REVIEW_MAIL_CMD=<명령> 으로 켠다.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/autocommit review
TimeoutStartSec=45min
